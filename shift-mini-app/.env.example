# Public browser values (safe to expose)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Local development only: allows selecting a demo user without Telegram.
# MUST be false in production.
VITE_DEMO_MODE=true

# Set these as Supabase Edge Function secrets, never in VITE_ variables:
# TELEGRAM_BOT_TOKEN=...
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_JWT_SECRET=...
# APP_TIMEZONE=Europe/Moscow
# APP_PUBLIC_URL=https://your-domain.example
